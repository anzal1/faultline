{
  "name": "@anzalabidi/faultline",
  "version": "0.5.1",
  "description": "A living architecture map for any codebase, any language, any coding agent. See what every change does to the structure, and stop it crossing the lines you drew.",
  "type": "module",
  "bin": {
    "fault": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "ui",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "architecture",
    "diagram",
    "code review",
    "dependency graph",
    "ai agents",
    "mcp",
    "claude code",
    "cursor",
    "codex",
    "copilot",
    "monorepo",
    "polyglot"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "elkjs": "^0.12.0",
    "oxc-parser": "^0.151.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anzal1/faultline.git"
  },
  "homepage": "https://github.com/anzal1/faultline#readme",
  "bugs": {
    "url": "https://github.com/anzal1/faultline/issues"
  }
}
