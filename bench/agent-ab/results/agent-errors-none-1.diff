+/**
+ * Adds a header naming the thrown error to 500 responses, but only when a
+ * coding agent is running the process, so it can see what failed without
+ * scraping the rendered error page.
+ */
+function setAgentDebugHeader(response: Response, status: 404 | 500, error: unknown): void {
+	if (status !== 500 || !isRunByAgent()) return;
+	try {
+		response.headers.set(ASTRO_ERROR_HEADER, error instanceof Error ? error.name : 'Error');
+	} catch {
+		// Headers may be immutable (e.g. a Response produced by a network fetch).
+	}
+}
