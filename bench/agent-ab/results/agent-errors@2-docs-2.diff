+/**
+ * Wraps {@link renderDefaultError}, attaching an `X-Astro-Error` header with
+ * the error's name to 500 responses when running under a coding agent, so the
+ * agent can see what failed without parsing the rendered error page.
+ */
+async function renderDefaultErrorWithAgentHeader(
+	manifest: SSRManifest,
+	request: Request,
+	options: RenderErrorOptions,
+): Promise<Response> {
+	const response = await renderDefaultError(manifest, request, options);
+	if (response.status === 500 && options.error instanceof Error && isRunByAgent()) {
+		response.headers.set('X-Astro-Error', options.error.name);
+	}
+	return response;
+}
