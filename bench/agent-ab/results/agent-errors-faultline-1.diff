import { detectAgenticEnvironment } from 'am-i-vibing';

export function isRunByAgent(): boolean {
	try {
		// "hybrid" environments such as Warp may not actually be running an AI agent.
		return detectAgenticEnvironment().type === 'agent';
	} catch {
		return false;
	}
}
