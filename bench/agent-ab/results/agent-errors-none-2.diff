+/**
+ * Adds the `X-Astro-Error` header with the error's name to 500 responses,
+ * but only when the process is being run by an AI coding agent (e.g. Claude
+ * Code), so the agent can see what failed without a human reading logs.
+ */
+function withAgentErrorHeader(response: Response, status: 404 | 500, error: unknown): Response {
+	if (status === 500 && error instanceof Error && isRunByAgent()) {
+		response.headers.set(ASTRO_ERROR_HEADER, error.name);
+	}
+	return response;
+}
