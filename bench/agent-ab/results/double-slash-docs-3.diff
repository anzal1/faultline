+/**
+ * Returns the collapsed pathname when `pathname` has duplicate trailing
+ * slashes (e.g. `/about//` → `/about/`), or `undefined` when there's
+ * nothing to collapse.
+ *
+ * Shared by the dev server (`evaluateTrailingSlash`) and the production app
+ * (`redirectTrailingSlash` below) so both redirect duplicate trailing
+ * slashes identically instead of each re-implementing the check.
+ */
+export function collapseDuplicateSlashRedirect(pathname: string): string | undefined {
+	const collapsed = collapseDuplicateTrailingSlashes(pathname, true);
+	return pathname && collapsed !== pathname ? collapsed : undefined;
