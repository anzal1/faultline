+
+/**
+ * Adds the error's name to the `X-Astro-Error` response header so an AI
+ * coding agent debugging the site can see what failed, without exposing
+ * that detail to regular visitors.
+ */
+function withAgentErrorHeader(response: Response, status: 404 | 500, error: unknown): Response {
+	if (status !== 500 || !(error instanceof Error) || !isRunByAgent()) {
+		return response;
+	}
+	try {
+		response.headers.set(ASTRO_ERROR_HEADER, error.name);
+	} catch {
+		// Headers may be immutable (e.g. a Response returned directly by user code).
+	}
 	return response;
 }
 
