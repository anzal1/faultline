+/**
+ * Adds an `X-Astro-Error` header with the error's name to 500 responses when
+ * the process is being run by an AI coding agent, so it can see what failed
+ * without having to parse the rendered error page.
+ */
+function addAgentErrorHeader(response: Response, status: 404 | 500, error: unknown): void {
+	if (status !== 500 || !(error instanceof Error)) return;
+	if (!isRunByAgent()) return;
+	response.headers.set(ASTRO_ERROR_HEADER, error.name);
+}
