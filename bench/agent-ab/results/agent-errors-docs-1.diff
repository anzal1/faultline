+/**
+ * Adds a header with the error's name to 500 responses so a coding agent
+ * debugging the site can see what failed, without exposing it to regular
+ * users. Reuses the CLI's existing agentic-environment detection.
+ */
+function addAgentErrorHeader(response: Response, status: number, error: unknown): void {
+	if (status !== 500 || !detectAgenticEnvironment().isAgentic) return;
+	response.headers.set('X-Astro-Error', error instanceof Error ? error.name : 'Error');
+}
