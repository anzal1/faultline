+/**
+ * Decision for duplicate trailing slashes (e.g. `/about//`), shared with the
+ * dev server's trailing-slash handling so both environments collapse them
+ * the same way. Returns the collapsed pathname, or `undefined` if `pathname`
+ * has no duplicate trailing slashes to collapse.
+ */
+export function collapseDuplicateTrailingSlashRedirect(pathname: string): string | undefined {
+	if (isInternalPath(pathname)) {
+		return undefined;
+	}
+	const collapsed = collapseDuplicateTrailingSlashes(pathname, true);
+	return pathname && collapsed !== pathname ? collapsed : undefined;
+}
