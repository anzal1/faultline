+/**
+ * Sets the `X-Astro-Error` header to the error's name when a 500 response is
+ * rendered under a coding agent, so the agent can see what failed without
+ * parsing the rendered error page.
+ */
+function setAgentErrorHeader(response: Response, status: 404 | 500, error: unknown): void {
+	if (status === 500 && isAgenticEnvironment && error instanceof Error) {
+		response.headers.set('X-Astro-Error', error.name);
+	}
