+/**
+ * Adds an `X-Astro-Error` header with the error's name to production 500
+ * responses when the process is being run by an AI coding agent, so an agent
+ * debugging the site can see what failed without digging through logs.
+ */
+function addAgentErrorHeader(response: Response, options: RenderErrorOptions) {
+	if (options.status !== 500 || !(options.error instanceof Error)) return;
+	if (!detectAgenticEnvironment().isAgentic) return;
+	response.headers.set('X-Astro-Error', options.error.name);
+}
